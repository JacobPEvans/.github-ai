{
  "pull_request_types": ["opened", "ready_for_review", "synchronize", "reopened"],
  "review_jobs": [
    { "job": "leak", "rubric": "leak", "model": "standard" },
    { "job": "security", "rubric": "security", "model": "critical" },
    { "job": "semantic", "rubric": "semantic", "model": "standard" }
  ],
  "required_jobs": ["gitleaks", "router", "leak", "security", "semantic"],
  "router_secrets": ["LLM_ROUTER_BASE_URL", "LLM_ROUTER_API_KEY"],
  "rubric_line": "A change that adds or edits a script or custom unit where a native or maintained way exists is CHANGES.",
  "gate_scenarios": [
    {
      "name": "all success",
      "draft": false,
      "results": ["success", "success", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 0,
      "verdict": "MERGE",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "failure",
      "draft": false,
      "results": ["failure", "success", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "cancellation",
      "draft": false,
      "results": ["success", "cancelled", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "draft skip",
      "draft": true,
      "results": ["success", "skipped", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 0,
      "verdict": "DEFERRED",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "non-draft skip",
      "draft": false,
      "results": ["success", "skipped", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "unknown result",
      "draft": false,
      "results": ["action_required", "success", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "private repo leak skip",
      "draft": false,
      "private": true,
      "results": ["success", "skipped", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 0,
      "verdict": "MERGE",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "private repo leak failure",
      "draft": false,
      "private": true,
      "results": ["success", "failure", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "private repo security skip",
      "draft": false,
      "private": true,
      "results": ["success", "success", "skipped", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "glm-4.7"
    },
    {
      "name": "private repo gitleaks skip",
      "draft": false,
      "private": true,
      "results": ["skipped", "skipped", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7"
    },
    {
      "name": "all reviews skipped on a draft pull request",
      "draft": true,
      "results": ["success", "skipped", "skipped", "skipped"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 0,
      "verdict": "DEFERRED",
      "model_line": "none"
    },
    {
      "name": "same-family review refused",
      "draft": false,
      "results": ["success", "success", "success", "success"],
      "models": ["glm-4.7", "glm-4.7", "glm-4.7"],
      "author_family": "zhipu",
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "glm-4.7",
      "reason_contains": "share the family zhipu"
    },
    {
      "name": "cross-family review passes",
      "draft": false,
      "results": ["success", "success", "success", "success"],
      "models": ["glm-4.7", "deepseek-v4", "glm-4.7"],
      "author_family": "anthropic",
      "exit_code": 0,
      "verdict": "MERGE",
      "model_line": "deepseek-v4, glm-4.7"
    },
    {
      "name": "one of two author families shared",
      "draft": false,
      "results": ["success", "success", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "author_family": "anthropic+zhipu",
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7",
      "reason_contains": "share the family anthropic"
    },
    {
      "name": "reviewer model unknown refused",
      "draft": false,
      "results": ["success", "success", "success", "success"],
      "models": ["glm-4.7", "", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "",
      "reason_contains": "reviewer model unknown"
    },
    {
      "name": "failed Copilot agent checks",
      "draft": false,
      "results": ["success", "success", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7",
      "copilot_failures": "2"
    },
    {
      "name": "unreadable Copilot agent checks",
      "draft": false,
      "results": ["success", "success", "success", "success"],
      "models": ["glm-4.7", "claude-opus-5-5", "glm-4.7"],
      "exit_code": 1,
      "verdict": "CHANGES",
      "model_line": "claude-opus-5-5, glm-4.7",
      "copilot_failures": "unreadable"
    }
  ]
}
