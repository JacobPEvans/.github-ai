{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>JacobPEvans/.github"
  ],
  "packageRules": [
    {
      "description": "ai-inference v3 is Copilot-only and ignores the endpoint input; the router calls need v2.",
      "matchPackageNames": [
        "actions/ai-inference"
      ],
      "allowedVersions": "<3"
    },
    {
      "description": "The OpenHands SDK's pinned litellm range supports Python below 3.15 only.",
      "matchFileNames": [
        ".github/workflows/openhands-review.yml"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
