+// Runs one gate-job step in a scratch workspace whose .ai-workflows scripts
+// symlink to the real ones, so the verdict step validates through
+// validate-verdict.sh exactly as it does on the runner. The caller removes dir.
+function runGateStep(stepId, env) {
+  const dir = mkdtempSync(join(tmpdir(), `merge-gate-${stepId}-`));
+  const linked = join(dir, '.ai-workflows', '.github');
+  mkdirSync(linked, { recursive: true });
+  symlinkSync(join(process.cwd(), '.github', 'scripts'), join(linked, 'scripts'));
+  const output = join(dir, 'step-output');
+  writeFileSync(output, '');
+  const result = Bun.spawnSync(['/bin/bash', '-c', stepById(stepId).run], {
+    cwd: dir,
+    env: { ...process.env, GITHUB_OUTPUT: output, ...env },
+  });
+  const outputs = Object.fromEntries(
+    readFileSync(output, 'utf8')
+      .trim()
+      .split('\n')
+      .filter(Boolean)
+      .map((line) => {
+        const eq = line.indexOf('=');
+        return [line.slice(0, eq), line.slice(eq + 1)];
+      }),
+  );
+  return { dir, result, outputs };
