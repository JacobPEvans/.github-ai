+
+  # The merge queue's mechanical check: an entry is queued only after its
+  # required checks passed, so the verdict check run already exists on the
+  # pull request head. This job re-reads it and reports the same check name
+  # the ruleset requires on the queue commit, once - no model call.
+  merge-group:
+    name: AI Merge Gate
+    if: github.event_name == 'merge_group'
+    runs-on: ${{ inputs.runner_label || 'ubuntu-24.04' }}
+    timeout-minutes: 2
+    permissions:
+      checks: read
+      contents: read
+    steps:
+      - name: Mint the check-run token
+        id: check-token
+        continue-on-error: true
+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3
+        with:
+          client-id: ${{ vars.GH_APP_CLAUDE_BOT_ID }}
+          private-key: ${{ secrets.GH_APP_CLAUDE_BOT_PRIVATE_KEY }}
+          permission-checks: write
+
+      - name: Checkout ai-workflows scripts
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          repository: JacobPEvans/.github-ai
+          ref: ${{ fromJSON(toJSON(job))['workflow_sha'] }}
+          sparse-checkout: .github/scripts
+          path: .ai-workflows
+          persist-credentials: false
+
+      - name: Verify the queued entry already carries its verdict
+        id: queue-verdict
+        timeout-minutes: 1
+        env:
+          GH_TOKEN: ${{ steps.check-token.outputs.token }}
+          CHECK_APP_SLUG: ${{ steps.check-token.outputs.app-slug }}
+          CHECK_HEAD_SHA: ${{ github.event.merge_group.head_sha || github.sha }}
+          HEAD_REF: ${{ github.event.merge_group.head_ref }}
+          REVIEWER_APP_SLUG: ${{ inputs.reviewer_app_slug }}
+        run: |
+          set -euo pipefail
+          # The queue branch is gh-readonly-queue/<base>/pr-<number>-<head
+          # sha>, and the tail sha is the pull request head the verdict was
+          # posted on.
+          if [[ "$HEAD_REF" =~ ^gh-readonly-queue/[^/]+/pr-([0-9]+)-([0-9a-f]{40})$ ]]; then
+            PR_NUMBER=${BASH_REMATCH[1]}
+            HEAD_SHA=${BASH_REMATCH[2]}
+          else
+            echo "::error::AI Merge Gate: unexpected queue branch '$HEAD_REF'; expected gh-readonly-queue/<base>/pr-<number>-<sha>"
+            bash .ai-workflows/.github/scripts/shared/check-run.sh upsert \
+              "AI Merge Gate" failure "AI Merge Gate" \
+              "unexpected queue branch '$HEAD_REF'; expected gh-readonly-queue/<base>/pr-<number>-<sha>"
+            exit 1
+          fi
+          # The gate reports the ruleset's required check from the reviewer
+          # App; without a minted token this job cannot report it at all.
+          if [ -z "$GH_TOKEN" ]; then
+            echo "::error::AI Merge Gate: pull request #$PR_NUMBER (head $HEAD_SHA): cannot report the verdict without an App token"
+            exit 1
+          fi
+          # A refusal reports failure under the same check name and fails the
+          # job, so the queue entry never waits on a verdict that will never
+          # arrive.
+          refuse() {
+            echo "::error::AI Merge Gate: pull request #$PR_NUMBER (head $HEAD_SHA): $1"
+            bash .ai-workflows/.github/scripts/shared/check-run.sh upsert \
+              "AI Merge Gate" failure "AI Merge Gate" "pull request #$PR_NUMBER (head $HEAD_SHA): $1"
+            exit 1
+          }
+          # The API occasionally returns a transient HTML error page; retry
+          # with backoff and judge only a readable response, as the gate does.
+          RUNS=""
+          for i in 1 2 3; do
+            RUNS=$(gh api -X GET \
+              "repos/$GITHUB_REPOSITORY/commits/$HEAD_SHA/check-runs" \
+              -f check_name="AI Merge Gate" \
+              -f filter=latest \
+              -f per_page=100) && break
+            sleep $((i * 5))
+          done
+          if [ -z "$RUNS" ]; then
+            refuse "could not read its check runs"
+          fi
+          if ! RUN="$(jq -r --arg name "AI Merge Gate" --arg slug "$REVIEWER_APP_SLUG" \
+            '(if type == "array" then . else (.check_runs // []) end)
+             | map(select(.name == $name and .app.slug == $slug))
+             | first // empty' <<< "$RUNS" 2>/dev/null)"; then
+            refuse "the check-run lookup returned an unreadable response"
+          fi
+          if [ -z "$RUN" ]; then
+            refuse "carries no 'AI Merge Gate' check run from the reviewer App $REVIEWER_APP_SLUG"
+          fi
+          CONCLUSION="$(jq -r '.conclusion // ""' <<< "$RUN")"
+          SUMMARY="$(jq -r '.output.summary // ""' <<< "$RUN")"
+          if [ "$CONCLUSION" != "success" ]; then
+            refuse "verdict check run concluded '${CONCLUSION:-none}', not success"
+          fi
+          if ! VERDICT_LINE="$(grep -xE 'VERDICT: (MERGE|DEFERRED)' <<< "$SUMMARY" | tail -n 1)"; then
+            refuse "verdict summary carries no 'VERDICT: MERGE' or 'VERDICT: DEFERRED' line"
+          fi
+          echo "AI Merge Gate: pull request #$PR_NUMBER (head $HEAD_SHA) carries an accepted verdict: $VERDICT_LINE"
+          bash .ai-workflows/.github/scripts/shared/check-run.sh upsert \
+            "AI Merge Gate" success "AI Merge Gate" \
+            "pull request #$PR_NUMBER (head $HEAD_SHA) carries $VERDICT_LINE from the reviewer App $REVIEWER_APP_SLUG"
