+      SEMANTIC_RESULT: 'success',
+      LEAK_MODEL: model,
+      SECURITY_MODEL: model,
+      SEMANTIC_MODEL: model,
+      LEAK_STATUS: 'ok',
+      SECURITY_STATUS: 'ok',
+      SEMANTIC_STATUS: 'ok',
+      COPILOT_OUTCOME: 'success',
+      COPILOT_FAILURES: '0',
+      AUTHOR_FAMILY: 'human',
+      HEAD_SHA: 'b'.repeat(40),
+    });
